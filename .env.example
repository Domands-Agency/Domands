# --- Local dev (SQLite) -----------------------------------------------------
# Leave DATABASE_URL as file: for local dev. Switch to a postgres:// URL in prod.
DATABASE_URL=file:./domands.db
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Production (Vercel + Supabase) ----------------------------------------
# DATABASE_URL: Supabase → Project Settings → Database → "Connection string" →
#   "Transaction pooler" (port 6543). Pooler is required on Vercel serverless.
#   Example: postgresql://postgres.<ref>:<pw>@aws-1-<region>.pooler.supabase.com:6543/postgres
# NEXT_PUBLIC_SERVER_URL: the public site URL, e.g. https://domandsagency.com
#
# Media storage: not configured. Images → Cloudinary, videos → YouTube (see README).

# --- Lead emails (SMTP) -----------------------------------------------------
# Leave SMTP_HOST empty to print emails to the server console instead of sending them.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@domandsagency.com
SMTP_PASS=
SMTP_FROM=info@domandsagency.com
SMTP_FROM_NAME=Domands website
# Who receives new-lead emails (comma-separate for several). Empty = the email in Site settings.
LEAD_EMAIL_TO=info@domandsagency.com
